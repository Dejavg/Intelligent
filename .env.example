# Optional API guard. Leave empty for local demo.
APP_API_TOKEN=

# OCR provider: mock | paddle | baidu | tencent | llm
OCR_PROVIDER=llm
OCR_FALLBACK_TO_MOCK=false
# false means real uploaded images will not silently use demo OCR answers.
ALLOW_MOCK_FOR_UPLOADED_IMAGES=false
# Stable competition demo: uploaded "自动识别/答题卡" uses the fixed 5-question math paper OCR.
DEMO_FIXED_MATH_PAPER_OCR=true
OCR_PREPROCESS_ENABLED=true
# Vision models usually handle original photos well. Set true if images are dark, skewed, or low contrast.
OCR_PREPROCESS_FOR_LLM=false
OCR_PREPROCESS_MAX_SIDE=1800
OCR_PREPROCESS_SAVE_DEBUG=false
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# Formula OCR provider: mock | mathpix | pix2tex | latex-ocr
FORMULA_OCR_PROVIDER=mock
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# LLM grading. Compatible with Kimi, DeepSeek, or custom OpenAI-compatible gateways.
LLM_ENABLED=true
LLM_PROVIDER=kimi
LLM_MODEL=kimi-k2.5
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
LLM_TIMEOUT=40
LLM_FALLBACK_TO_RULE=true
LLM_VISION_ENABLED=true
LLM_VISION_MODEL=kimi-k2.5
LLM_VISION_OCR=true
LLM_GRADE_FROM_IMAGE=true
